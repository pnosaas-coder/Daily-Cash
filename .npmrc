auto-install-peers=true
strict-peer-dependencies=false
# Flat node_modules (npm-style). The default isolated layout nests packages
# under node_modules/.pnpm/<long-name>/, which pushes paths past Windows'
# 260-char limit when the repo lives in a deep folder — Turbopack then fails
# with "Module not found" on @sentry/nextjs and @vercel/otel.
node-linker=hoisted
